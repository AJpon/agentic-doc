{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://agentic-doc/schemas/catalogue.schema.json",
  "title": "agentic-doc wiki catalogue",
  "type": "object",
  "additionalProperties": false,
  "required": ["version", "chapters", "pages"],
  "properties": {
    "version": { "const": 1 },
    "title": { "type": "string" },
    "chapters": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["id", "title", "description"],
        "properties": {
          "id": { "type": "string", "minLength": 1 },
          "title": { "type": "string", "minLength": 1 },
          "description": { "type": "string" }
        }
      }
    },
    "pages": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["id", "path", "title", "audience", "brief", "sources", "related", "source_commit", "reviewed_at"],
        "properties": {
          "id": { "type": "string", "minLength": 1 },
          "path": { "type": "string", "minLength": 1 },
          "title": { "type": "string", "minLength": 1 },
          "audience": { "type": "array", "items": { "type": "string" } },
          "brief": { "type": "string" },
          "sources": { "type": "array", "minItems": 1, "items": { "type": "string", "minLength": 1 } },
          "related": { "type": "array", "items": { "type": "string" } },
          "source_commit": { "type": ["string", "null"], "pattern": "^[0-9a-f]{40}$" },
          "reviewed_at": { "type": ["string", "null"], "pattern": "^\\d{4}-\\d{2}-\\d{2}$" }
        }
      }
    }
  }
}

{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "agentic-doc command result",
  "description": "Exit code and verbatim output of one command (step-command)",
  "type": "object",
  "required": [
    "exit_code",
    "stdout",
    "stderr"
  ],
  "properties": {
    "exit_code": {
      "type": "integer"
    },
    "stdout": {
      "type": "string"
    },
    "stderr": {
      "type": "string"
    }
  }
}

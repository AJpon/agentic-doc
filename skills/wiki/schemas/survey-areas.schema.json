{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "agentic-doc survey areas",
  "description": "How outline splits the repository for the survey (outline-areas)",
  "type": "object",
  "required": [
    "areas"
  ],
  "properties": {
    "areas": {
      "type": "array",
      "minItems": 3,
      "maxItems": 5,
      "items": {
        "type": "object",
        "required": [
          "key",
          "title",
          "scope",
          "questions"
        ],
        "properties": {
          "key": {
            "type": "string",
            "pattern": "^[a-z0-9][a-z0-9-]*$"
          },
          "title": {
            "type": "string"
          },
          "scope": {
            "type": "array",
            "items": {
              "type": "string"
            }
          },
          "questions": {
            "type": "array",
            "items": {
              "type": "string"
            }
          }
        }
      }
    }
  }
}

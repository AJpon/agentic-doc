{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "agentic-doc survey",
  "description": "Findings about one area of the repository (outline-survey)",
  "type": "object",
  "required": [
    "area",
    "summary",
    "findings"
  ],
  "properties": {
    "area": {
      "type": "string"
    },
    "summary": {
      "type": "string"
    },
    "findings": {
      "type": "array",
      "items": {
        "type": "object",
        "required": [
          "topic",
          "detail",
          "evidence"
        ],
        "properties": {
          "topic": {
            "type": "string"
          },
          "detail": {
            "type": "string"
          },
          "evidence": {
            "type": "array",
            "minItems": 1,
            "items": {
              "type": "string"
            }
          }
        }
      }
    },
    "doc_gaps": {
      "type": "array",
      "items": {
        "type": "string"
      }
    }
  }
}

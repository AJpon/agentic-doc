{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "agentic-doc research result",
  "description": "Facts gathered for one page (sync-research)",
  "type": "object",
  "required": [
    "page_id",
    "note_path",
    "key_claims"
  ],
  "properties": {
    "page_id": {
      "type": "string"
    },
    "note_path": {
      "type": "string"
    },
    "key_claims": {
      "type": "array",
      "items": {
        "type": "object",
        "required": [
          "claim",
          "evidence"
        ],
        "properties": {
          "claim": {
            "type": "string"
          },
          "evidence": {
            "type": "array",
            "minItems": 1,
            "items": {
              "type": "string"
            }
          }
        }
      }
    },
    "diagrams": {
      "type": "array",
      "items": {
        "type": "object",
        "required": [
          "kind",
          "subject"
        ],
        "properties": {
          "kind": {
            "type": "string"
          },
          "subject": {
            "type": "string"
          }
        }
      }
    },
    "terms": {
      "type": "array",
      "items": {
        "type": "string"
      }
    },
    "open_questions": {
      "type": "array",
      "items": {
        "type": "string"
      }
    }
  }
}

{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "agentic-doc findings",
  "description": "Unresolved review findings of one page (findings save)",
  "type": "array",
  "items": {
    "type": "object",
    "required": [
      "severity",
      "location",
      "problem",
      "fix"
    ],
    "additionalProperties": false,
    "properties": {
      "severity": {
        "type": "string",
        "enum": [
          "blocker",
          "major",
          "minor"
        ]
      },
      "location": {
        "type": "string"
      },
      "problem": {
        "type": "string"
      },
      "fix": {
        "type": "string"
      },
      "lens": {
        "type": "string"
      }
    }
  }
}
